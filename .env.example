VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_PUBLIC_APP_URL=https://your-public-pathly-origin.example
# Server-only Supabase Edge Function secrets (never prefix with VITE_):
# GOOGLE_CALENDAR_CLIENT_ID
# GOOGLE_CALENDAR_CLIENT_SECRET
# GOOGLE_CALENDAR_REDIRECT_URI=https://your-project.supabase.co/functions/v1/google-calendar-oauth-callback
# GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY (base64-encoded 32 random bytes)
# PATHLY_APP_URL=https://your-public-pathly-origin.example
# Landing page "Watch 2-minute demo" link (Loom/Vimeo/Vidyard). Leave unset to hide the CTA.
VITE_DEMO_VIDEO_URL=
